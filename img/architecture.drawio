<mxfile host="drawio" agent="Claude Code">
  <diagram id="agentmanager-architecture" name="Architecture">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1000" pageHeight="700" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Main server -->
        <mxCell id="server" value="&lt;b&gt;Main Server + UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;distance matrix · global best&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- AgentManager container -->
        <mxCell id="am" value="&lt;b&gt;AgentManager&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#555555&quot;&gt;× N nodes&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="940" height="460" as="geometry"/>
        </mxCell>

        <mxCell id="handler" value="&lt;b&gt;WebSocket handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;/ws · conn/connection.go&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="220" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="global" value="&lt;b&gt;Global best&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;route + distance&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="220" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- RunSwarm container -->
        <mxCell id="swarm" value="&lt;b&gt;RunSwarm&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#555555&quot;&gt;epoch loop · core/core.go&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;dashPattern=6 4;fontColor=#000000;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="860" height="270" as="geometry"/>
        </mxCell>

        <!-- Agents group -->
        <mxCell id="agents" value="&lt;font color=&quot;#555555&quot;&gt;ACO + 2-Opt · 10 iterations per epoch · all agents run in parallel&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=11;verticalAlign=bottom;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="100" y="370" width="780" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;Agent 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Explorer&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="112" y="382" width="116" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;Agent 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Exploiter&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="382" width="116" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;Agent 3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Diversifier&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="368" y="382" width="116" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;Agent 4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Explorer&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="496" y="382" width="116" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;Agent 5&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Exploiter&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="624" y="382" width="116" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="&lt;b&gt;Agent 6&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Diversifier&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="752" y="382" width="116" height="48" as="geometry"/>
        </mxCell>

        <!-- Epoch steps -->
        <mxCell id="report" value="&lt;b&gt;Report&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;send local_best if the&lt;br&gt;epoch's best improved&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="105" y="500" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="merge" value="&lt;b&gt;Merge pheromones&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;weighted by 1 / tour length&lt;br&gt;reinforce edges shared by ≥ 2 agents&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="375" y="500" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="adapt" value="&lt;b&gt;Adapt agents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;reset if stagnant · tune ant count&lt;br&gt;blend merged trail · inject global best&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="645" y="500" width="235" height="80" as="geometry"/>
        </mxCell>

        <!-- Edges: main server <-> handler -->
        <mxCell id="e-down" value="start (matrix)&lt;br&gt;global_best (route)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="80" as="sourcePoint"/>
            <mxPoint x="440" y="220" as="targetPoint"/>
            <mxPoint x="0" y="-15" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-up" value="local_best (route)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="220" as="sourcePoint"/>
            <mxPoint x="560" y="80" as="targetPoint"/>
            <mxPoint x="0" y="-15" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-ws" value="WebSocket · JSON" style="text;html=1;align=left;verticalAlign=middle;fontColor=#555555;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="115" width="140" height="20" as="geometry"/>
        </mxCell>

        <!-- Edges inside AgentManager -->
        <mxCell id="e-global" value="global_best" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="handler" target="global">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-start" value="start / restart" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="280" as="sourcePoint"/>
            <mxPoint x="500" y="330" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-read" value="read each epoch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;dashed=1;dashPattern=3 3;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="830" y="280" as="sourcePoint"/>
            <mxPoint x="830" y="330" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-local" value="local_best" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="report" target="handler">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="60" y="540"/>
              <mxPoint x="60" y="250"/>
            </Array>
            <mxPoint x="80" y="0" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Epoch flow -->
        <mxCell id="e-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="462" as="sourcePoint"/>
            <mxPoint x="220" y="500" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#000000;" edge="1" parent="1" source="report" target="merge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#000000;" edge="1" parent="1" source="merge" target="adapt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-loop" value="next&lt;br&gt;epoch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#000000;fontColor=#000000;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="adapt" target="agents">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="910" y="540"/>
              <mxPoint x="910" y="416"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
